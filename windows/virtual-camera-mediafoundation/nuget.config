<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the packages.config restore location for all projects in this folder to
  windows\virtual-camera-mediafoundation\packages (relative to this file), so
  restore lands in the same place regardless of how it is invoked (VS, nuget.exe,
  or dev-build-vcam.ps1's msbuild /t:Restore). The vcxproj files resolve packages
  via $(SolutionDir)packages; dev-build-vcam.ps1 passes SolutionDir to match.
-->
<configuration>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
